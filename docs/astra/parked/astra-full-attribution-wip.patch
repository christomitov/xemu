+/*
+ * Diagnostic bitmask, off by default (no generated probes when off):
+ * 1: inline-helper/call-site phases, 2: SoftMMU phases,
+ * 4: per-helper logical/inline/import/sticky counts, 8: SSE subphases.
+ * Counter/phase overhead must be measured against an uninstrumented run.
+ */
+static int wasm_jit_profile(void)
+{
+    static int flags = -1;
+
+    if (flags < 0) {
+        const char *e = getenv("XEMU_WASM_JIT_PROFILE");
+        flags = e ? atoi(e) & 15 : 0;
+    }
+    return flags;
+}
+
+enum {
+    JPROF_LOGICAL, JPROF_INLINE, JPROF_FAST_IMPORT, JPROF_IMPORT,
+    JPROF_STICKY, JPROF_COUNT
+};
 #define HPROF_N 4096
-static struct { uintptr_t fn; const char *name; uint64_t n; } hprof[HPROF_N];
+typedef struct WasmHelperProfile {
+    uintptr_t fn;
+    const char *name;
+    uint64_t n;                 /* legacy optional counter */
+    uint64_t diag[JPROF_COUNT]; /* separate cumulative diagnostic counts */
+} WasmHelperProfile;
+static WasmHelperProfile hprof[HPROF_N];
+
+static WasmHelperProfile *wasm_helper_profile(const void *func,
+                                             const TCGHelperInfo *info)
+{
+    uint32_t i = ((uintptr_t)func * 2654435761u) % HPROF_N;
+
+    for (int n = 0; n < HPROF_N; n++, i = (i + 1) % HPROF_N) {
+        if (!hprof[i].fn || hprof[i].fn == (uintptr_t)func) {
+            hprof[i].fn = (uintptr_t)func;
+            hprof[i].name = info->name;
+            return &hprof[i];
+        }
+    }
+    return NULL;
+}
+
+static void wasm_jit_count(TCGContext *s, const void *func,
+                           const TCGHelperInfo *info, unsigned which)
+{
+    if (wasm_jit_profile() & 4) {
+        WasmHelperProfile *p = wasm_helper_profile(func, info);
+        if (p) {
+            wasm_count(s, &p->diag[which]);
+        }
+    }
+}
+
+/*
+ * Distinct from xemu_wasm_helper_top(), which counts ONLY TCI calls.
+ * Cumulative since startup, not reset by the legacy hprof dump:
+ * name=logical/inline/fast_import/original_import/sticky_inexact;
+ * Imports count actual emitted calls (including Asyncify replay/verification).
+ * fast_import is the i128 C probe, not an inline hit or a softfloat result.
+ */
+EMSCRIPTEN_KEEPALIVE const char *xemu_wasm_jit_helper_top(void)
+{
+    static char buf[4096];
+    bool used[HPROF_N] = { false };
+    int len = 0;
+
+    buf[0] = 0;
+    for (int n = 0; n < 24; n++) {
+        int best = -1;
+        for (int i = 0; i < HPROF_N; i++) {
+            if (!used[i] && hprof[i].diag[JPROF_LOGICAL] &&
+                (best < 0 || hprof[i].diag[JPROF_LOGICAL] >
+                             hprof[best].diag[JPROF_LOGICAL])) {
+                best = i;
+            }
+        }
+        if (best < 0 || len > sizeof(buf) - 256) {
+            break;
+        }
+        used[best] = true;
+        WasmHelperProfile *p = &hprof[best];
+        len += snprintf(buf + len, sizeof(buf) - len,
+                        "%s=%llu/%llu/%llu/%llu/%llu;",
+                        p->name ? p->name : "?",
+                        (unsigned long long)p->diag[JPROF_LOGICAL],
+                        (unsigned long long)p->diag[JPROF_INLINE],
+                        (unsigned long long)p->diag[JPROF_FAST_IMPORT],
+                        (unsigned long long)p->diag[JPROF_IMPORT],
+                        (unsigned long long)p->diag[JPROF_STICKY]);
+    }
+    return buf;
+}
 
